        <!-- Gemini AI Custom Generator Button -->
        <button onclick="openCustomAiModal()" class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 hover:opacity-95 text-white font-extrabold text-xs shadow-lg shadow-indigo-500/25 transition active:scale-95 flex items-center gap-1.5">
          <i class="fa-solid fa-wand-magic-sparkles text-yellow-300"></i>
          <span>Gemini AI</span>
        </button>
      </div>

    </div>
  </header>

