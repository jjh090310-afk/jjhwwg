    // App Global State
    let currentTheme = null;
    let currentQuestions = [];
    let currentQuestionIdx = 0;
    let userAnswers = [];
    let currentSort = 'popular';
    let currentCat = 'all';
    let visibleCount = 30;
    let mbtiChartInstance = null;

    // Initialization
    window.onload = () => {
      renderCategories();
      renderCatalog();
      populateMbtiSelects();
      startLiveTicker();
      setupKeyboardShortcuts();
    };

    function switchPage(pageId) {
      document.querySelectorAll('.page-screen').forEach(el => el.classList.remove('active'));
      const target = document.getElementById(`${pageId}-page`);
      if (target) {
        target.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 2500);
    }

    function startLiveTicker() {
      const tickerText = document.getElementById('live-ticker-text');
      const cities = ['서울', '부산', '인천', '대구', '광주', '대전', '제주'];
      const themes = ['퇴사 칼퇴 직장인', '조선 퇴마사', '좀비 생존 대책위', '로또 100억 당첨자', '학원물 소꿉친구'];

      setInterval(() => {
        const randCity = cities[Math.floor(Math.random() * cities.length)];
        const randTheme = themes[Math.floor(Math.random() * themes.length)];
        if (tickerText) {
          tickerText.innerText = `실시간: ${randCity}에서 '${randTheme}' 진행 중`;
        }
      }, 4000);
    }

    function renderCategories() {
      const container = document.getElementById('category-container');
      container.innerHTML = '';
      CATEGORIES.forEach(c => {
        const btn = document.createElement('button');
        const isActive = c.id === currentCat;
        btn.className = `px-4 py-2 rounded-2xl text-xs font-black transition whitespace-nowrap shadow-sm ${
          isActive 
            ? 'bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white shadow-indigo-500/20' 
            : 'bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
        }`;
        btn.innerText = c.name;
        btn.onclick = () => {
          currentCat = c.id;
          visibleCount = 30;
          renderCategories();
          renderCatalog();
        };
        container.appendChild(btn);
      });
    }

    function setSortMode(mode) {
      currentSort = mode;
      document.getElementById('sort-popular-btn').className = mode === 'popular' ? 'px-3 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white shadow-sm' : 'px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
      document.getElementById('sort-newest-btn').className = mode === 'newest' ? 'px-3 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white shadow-sm' : 'px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white';
      renderCatalog();
    }

    function handleSearch() {
      const input = document.getElementById('search-input').value.trim();
      const clearBtn = document.getElementById('clear-search-btn');
      if (input) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      visibleCount = 30;
      renderCatalog();
    }

    function clearSearch() {
      document.getElementById('search-input').value = '';
      document.getElementById('clear-search-btn').classList.add('hidden');
      renderCatalog();
    }

    function renderCatalog() {
      const grid = document.getElementById('theme-grid');
      grid.innerHTML = '';

      let filtered = [...CATALOG];

      if (currentCat !== 'all' && currentCat !== 'popular') {
        filtered = filtered.filter(t => t.cat === currentCat);
      }

      const searchVal = document.getElementById('search-input').value.trim().toLowerCase();
      if (searchVal) {
        filtered = filtered.filter(t => 
          t.title.toLowerCase().includes(searchVal) || 
          t.setting.toLowerCase().includes(searchVal) ||
          t.role.toLowerCase().includes(searchVal)
        );
      }

      if (currentSort === 'newest') {
        filtered.reverse();
      }

      document.getElementById('total-count-num').innerText = filtered.length;
      document.getElementById('total-count-text').innerText = filtered.length;

      const itemsToShow = filtered.slice(0, visibleCount);
      document.getElementById('visible-count-text').innerText = itemsToShow.length;

      const loadMoreBox = document.getElementById('load-more-box');
      if (itemsToShow.length >= filtered.length) {
        loadMoreBox.classList.add('hidden');
      } else {
        loadMoreBox.classList.remove('hidden');
      }

      itemsToShow.forEach(item => {
        const card = document.createElement('div');
        card.className = "glass-card glass-card-interactive p-5 rounded-3xl cursor-pointer border border-slate-200 dark:border-slate-800 flex flex-col justify-between group";
        card.onclick = () => openIntroPage(item);

        const catObj = CATEGORIES.find(c => c.id === item.cat) || { name: '일반' };

        card.innerHTML = `
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-black px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-indigo-600 dark:text-indigo-400">
                ${catObj.name}
              </span>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 font-extrabold flex items-center gap-1">
                <i class="fa-solid fa-fire text-amber-500"></i> ${item.participants}
              </span>
            </div>

            <div class="flex items-start gap-3.5 mb-3">
              <div class="w-12 h-12 rounded-2xl bg-indigo-50/80 dark:bg-slate-950 border border-indigo-100 dark:border-slate-800 flex items-center justify-center text-2xl group-hover:scale-110 transition duration-300 shrink-0">
                ${item.icon}
              </div>
              <div>
                <h3 class="text-sm font-black text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition line-clamp-1 mb-1">${item.title}</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed font-medium">${item.setting}</p>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/60 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 font-bold">
            <span>역할: ${item.role}</span>
            <span class="text-indigo-600 dark:text-indigo-400 font-black group-hover:translate-x-1 transition flex items-center gap-1">
              시작하기 <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </span>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function loadMoreThemes() {
      visibleCount += 30;
      renderCatalog();
    }

    function buildStandardQuestions(theme) {
      if (theme.customQuestions && theme.customQuestions.length > 0) {
        return theme.customQuestions;
      }

      const r = theme.role || "주인공";
      const s = theme.setting || "시나리오";

      return [
        { axis: 'E/I', q: `${s}에 돌입했다! 돌발 사건에 주변 사람들이 수다를 떨 때 ${r}인 당신은?`, A: "적극적으로 주도하며 대화를 건네 상황을 장악한다.", B: "구석에서 조용히 상황 변화와 데이터 관찰에 집중한다." },
        { axis: 'E/I', q: `동료나 협력 동반자를 새로 모집해야 할 때?`, A: "광장이나 커뮤니티에 공개 공고를 올려 시끌벅적 모은다.", B: "믿을 수 있는 인원만 조용히 일대일로 컨택한다." },
        { axis: 'E/I', q: `치열했던 주요 임무를 마친 후 당신만의 휴식법은?`, A: "팀원들과 모여 축배를 들고 수다 떨며 풀어낸다.", B: "혼자만의 공간으로 돌아가 조용히 체력을 회복한다." },

        { axis: 'S/N', q: `${s} 도중 의문의 단서를 발견했을 때 당신의 직감은?`, A: "눈앞의 명확한 사실과 현실적 데이터부터 검증한다.", B: "단서 뒤에 숨겨진 거대한 비전과 기발한 가능성을 상상한다." },
        { axis: 'S/N', q: `중요한 기로에서 결정을 내려야 하는 순간?`, A: "과거 성공 사례와 확실한 수치를 토대로 결정한다.", B: "설명하기 어렵지만 가슴속 촉과 직감을 믿고 지른다." },
        { axis: 'S/N', q: `${r}로서 스킬이나 비급을 전수받을 때 선호하는 타입은?`, A: "당장 실전에서 사용할 수 있는 기민하고 실용적인 스킬.", B: "원리가 깊고 확장 가능성이 무궁무진한 비급." },

        { axis: 'T/F', q: `동료가 실수를 저질러 차질이 생겼을 때 반응은?`, A: "원인을 즉시 규명하고 차가운 원복 대책을 세운다.", B: "당황했을 동료의 마음을 먼저 위로하고 기운을 북돋아 준다." },
        { axis: 'T/F', q: `막대한 전리품과 보상을 나누는 기준은?`, A: "기여도와 공적 지표에 따른 엄격하고 객관적인 분배.", B: "누구도 서운함이 없도록 배려한 조화로운 분배." },
        { axis: 'T/F', q: `타인이 나에게 도움을 요청할 때 판단의 핵심은?`, A: "이 요청이 객관적으로 타당하고 시의적절한지 계산.", B: "상대의 절박한 상황과 마음의 감정에 깊이 공감." },

        { axis: 'J/P', q: `거대한 작전을 앞둔 전날 밤 당신의 준비 스타일은?`, A: "타임라인과 체크리스트를 분 단위로 치밀하게 점검.", B: "대략적인 구상만 해두고 내일 현장에서 유연하게 대응." },
        { axis: 'J/P', q: `기존 계획이 예고 없이 어그러졌을 때?`, A: "준비해 두었던 플랜 B와 플랜 C를 순차 작동시킨다.", B: "순발력을 발휘해 순간적인 꼼수와 기지로 돌파한다." },
        { axis: 'J/P', q: `${s}에서 완벽한 자유시간 1일이 주어졌다면?`, A: "아침부터 저녁까지 스케줄을 짜서 알차게 보낸다.", B: "발길 닿는 대로 유유자적 탐험하며 순간을 즐긴다." }
      ];
    }

    function openIntroPage(theme) {
      currentTheme = theme;
      currentQuestions = buildStandardQuestions(theme);

      const catObj = CATEGORIES.find(c => c.id === theme.cat) || { name: '일반' };

      document.getElementById('intro-icon').innerText = theme.icon;
      document.getElementById('intro-category-label').innerText = catObj.name;
      document.getElementById('intro-title').innerText = theme.title;
      document.getElementById('intro-desc').innerText = `'${theme.setting}' 속에서 당신은 어떤 판단을 할까요? 단 3분 만에 당신의 본질 스펙트럼을 분석합니다.`;
      document.getElementById('intro-q-count').innerText = `${currentQuestions.length}문항`;
      document.getElementById('intro-participants').innerText = theme.participants || '24.1만명';

      switchPage('intro');
    }

    function startQuiz() {
      currentQuestionIdx = 0;
      userAnswers = [];
      showQuestion();
      switchPage('quiz');
    }

    function setupKeyboardShortcuts() {
      document.addEventListener('keydown', (e) => {
        const quizPage = document.getElementById('quiz-page');
        if (quizPage && quizPage.classList.contains('active')) {
          if (e.key === '1' || e.key.toLowerCase() === 'a') {
            handleOptionSelect('A');
          } else if (e.key === '2' || e.key.toLowerCase() === 'b') {
            handleOptionSelect('B');
          }
        }
      });
    }

    function showQuestion(direction = 'next') {
      const q = currentQuestions[currentQuestionIdx];
      const total = currentQuestions.length;
      const progressRatio = ((currentQuestionIdx + 1) / total) * 100;

      document.getElementById('quiz-theme-icon').innerText = currentTheme.icon;
      document.getElementById('quiz-theme-title').innerText = currentTheme.title;
      document.getElementById('quiz-step-counter').innerText = `Q.${String(currentQuestionIdx + 1).padStart(2, '0')} / ${total}`;
      document.getElementById('quiz-progress-bar').style.width = `${progressRatio}%`;

      document.getElementById('quiz-axis-badge').innerText = `${q.axis} 측정 축`;
      document.getElementById('quiz-question-text').innerText = q.q;
      document.getElementById('option-a-text').innerText = q.A;
      document.getElementById('option-b-text').innerText = q.B;

      const cardBox = document.getElementById('question-card-box');
      cardBox.classList.remove('slide-enter-next', 'slide-enter-prev');
      void cardBox.offsetWidth; // Trigger reflow
      cardBox.classList.add(direction === 'next' ? 'slide-enter-next' : 'slide-enter-prev');

      // Back button visibility
      const backBtn = document.getElementById('quiz-back-btn');
      if (currentQuestionIdx > 0) {
        backBtn.classList.remove('invisible');
      } else {
        backBtn.classList.add('invisible');
      }
    }

    function goToPrevQuestion() {
      if (currentQuestionIdx > 0) {
        currentQuestionIdx--;
        userAnswers.pop();
        showQuestion('prev');
      }
    }

    function handleOptionSelect(choice) {
      const q = currentQuestions[currentQuestionIdx];
      userAnswers.push({ axis: q.axis, choice: choice });

      currentQuestionIdx++;

      if (currentQuestionIdx < currentQuestions.length) {
        showQuestion('next');
      } else {
        calculateAndShowResult();
      }
    }

    function calculateAndShowResult() {
      const scores = { E: 0, I: 0, S: 0, N: 0, T: 0, F: 0, J: 0, P: 0 };

      userAnswers.forEach(ans => {
        const [typeA, typeB] = ans.axis.split('/');
        if (ans.choice === 'A') {
          scores[typeA]++;
        } else {
          scores[typeB]++;
        }
      });

      const mbti = 
        (scores.E >= scores.I ? 'E' : 'I') +
        (scores.S >= scores.N ? 'S' : 'N') +
        (scores.T >= scores.F ? 'T' : 'F') +
        (scores.J >= scores.P ? 'J' : 'P');

      const mbtiData = FULL_16_MBTI[mbti] || FULL_16_MBTI['ENFP'];

      document.getElementById('result-mbti-code').innerText = mbti;
      document.getElementById('result-type-title').innerText = `${mbtiData.title}`;
      document.getElementById('result-type-sub').innerText = `"${currentTheme.role} - ${mbtiData.sub}"`;
      document.getElementById('result-icon-box').innerText = mbtiData.icon;
      document.getElementById('best-match-title').innerText = mbtiData.best;
      document.getElementById('worst-match-title').innerText = mbtiData.worst;

      // Render 5 Key Traits
      const traitsList = document.getElementById('result-traits-list');
      traitsList.innerHTML = '';
      mbtiData.traits.forEach((trait, index) => {
        const li = document.createElement('li');
        li.className = "flex items-start gap-2.5 text-xs sm:text-sm";
        li.innerHTML = `<span class="w-5 h-5 rounded-full bg-indigo-500/10 text-indigo-500 font-bold flex items-center justify-center shrink-0 text-[11px]">${index + 1}</span> <span>${trait}</span>`;
        traitsList.appendChild(li);
      });

      // Calculate Percentages
      const calcPct = (a, b) => {
        const total = (scores[a] + scores[b]) || 1;
        return {
          pctA: Math.round((scores[a] / total) * 100),
          pctB: Math.round((scores[b] / total) * 100)
        };
      };

      const ei = calcPct('E', 'I');
      const sn = calcPct('S', 'N');
      const tf = calcPct('T', 'F');
      const jp = calcPct('J', 'P');

      document.getElementById('label-e').innerText = `외향 (E) ${ei.pctA}%`;
      document.getElementById('label-i').innerText = `내향 (I) ${ei.pctB}%`;
      document.getElementById('bar-e').style.width = `${ei.pctA}%`;
      document.getElementById('bar-i').style.width = `${ei.pctB}%`;

      document.getElementById('label-s').innerText = `감각 (S) ${sn.pctA}%`;
      document.getElementById('label-n').innerText = `직관 (N) ${sn.pctB}%`;
      document.getElementById('bar-s').style.width = `${sn.pctA}%`;
      document.getElementById('bar-n').style.width = `${sn.pctB}%`;

      document.getElementById('label-t').innerText = `사고 (T) ${tf.pctA}%`;
      document.getElementById('label-f').innerText = `감정 (F) ${tf.pctB}%`;
      document.getElementById('bar-t').style.width = `${tf.pctA}%`;
      document.getElementById('bar-f').style.width = `${tf.pctB}%`;

      document.getElementById('label-j').innerText = `판단 (J) ${jp.pctA}%`;
      document.getElementById('label-p').innerText = `인식 (P) ${jp.pctB}%`;
      document.getElementById('bar-j').style.width = `${jp.pctA}%`;
      document.getElementById('bar-p').style.width = `${jp.pctB}%`;

      renderRadarChart(ei.pctA, sn.pctA, tf.pctA, jp.pctA);

      // Trigger Confetti Celebration
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 80,
          spread: 70,
          origin: { y: 0.6 }
        });
      }

      switchPage('result');
    }

    function renderRadarChart(eVal, sVal, tVal, jVal) {
      const ctx = document.getElementById('mbtiRadarChart');
      if (!ctx) return;

      if (mbtiChartInstance) {
        mbtiChartInstance.destroy();
      }

      const isDark = document.documentElement.classList.contains('dark');
      const gridColor = isDark ? 'rgba(255, 255, 255, 0.15)' : 'rgba(0, 0, 0, 0.1)';
      const labelColor = isDark ? '#f3f4f6' : '#1e293b';

      mbtiChartInstance = new Chart(ctx, {
        type: 'radar',
        data: {
          labels: ['외향 (E)', '감각 (S)', '사고 (T)', '판단 (J)'],
          datasets: [{
            label: '성향 레벨 (%)',
            data: [eVal, sVal, tVal, jVal],
            backgroundColor: 'rgba(99, 102, 241, 0.25)',
            borderColor: '#6366f1',
            borderWidth: 3,
            pointBackgroundColor: '#ec4899',
            pointBorderColor: '#fff',
            pointHoverBackgroundColor: '#fff',
            pointHoverBorderColor: '#ec4899'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            r: {
              angleLines: { color: gridColor },
              grid: { color: gridColor },
              pointLabels: {
                color: labelColor,
                font: { size: 11, weight: 'bold', family: 'Pretendard' }
              },
              ticks: { display: false },
              suggestedMin: 0,
              suggestedMax: 100
            }
          },
          plugins: {
            legend: { display: false }
          }
        }
      });
    }

    function triggerSlotMachineGacha() {
      const modal = document.getElementById('slot-modal');
      modal.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeSlotModal() {
      const modal = document.getElementById('slot-modal');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }

    function runSlotMachine() {
      const btn = document.getElementById('slot-spin-btn');
      const icon = document.getElementById('slot-display-icon');
      const text = document.getElementById('slot-display-text');

      btn.disabled = true;
      let counter = 0;

      const interval = setInterval(() => {
        const rand = CATALOG[Math.floor(Math.random() * CATALOG.length)];
        icon.innerText = rand.icon;
        text.innerText = rand.title;
        counter++;

        if (counter > 18) {
          clearInterval(interval);
          btn.disabled = false;
          closeSlotModal();
          openIntroPage(rand);
          showToast(`🎯 당첨! '${rand.title}' 로 이동합니다.`);
        }
      }, 70);
    }

    function shareLink() {
      const dummy = document.createElement('input');
      document.body.appendChild(dummy);
      dummy.value = window.location.href;
      dummy.select();
      document.execCommand('copy');
      document.body.removeChild(dummy);
      showToast("📋 결과 링크가 클립보드에 복사되었습니다!");
    }

    function generateResultImageCard() {
      showToast("🎨 HD 포토카드 생성 중...");

      const isDark = document.documentElement.classList.contains('dark');
      const canvas = document.createElement('canvas');
      canvas.width = 800;
      canvas.height = 1000;
      const ctx = canvas.getContext('2d');

      // Gradient Background
      const grad = ctx.createLinearGradient(0, 0, 800, 1000);
      if (isDark) {
        grad.addColorStop(0, '#0f172a');
        grad.addColorStop(0.5, '#1e1b4b');
        grad.addColorStop(1, '#030712');
      } else {
        grad.addColorStop(0, '#ffffff');
        grad.addColorStop(0.5, '#f0f3ff');
        grad.addColorStop(1, '#e0e7ff');
      }
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 800, 1000);

      // Card Border
      ctx.strokeStyle = isDark ? 'rgba(129, 140, 248, 0.4)' : 'rgba(99, 102, 241, 0.3)';
      ctx.lineWidth = 4;
      ctx.strokeRect(30, 30, 740, 940);

      // Header Brand
      ctx.fillStyle = isDark ? '#818cf8' : '#4f46e5';
      ctx.font = 'bold 26px Pretendard, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('MIND LAB PRO • SPECTRUM REPORT', 400, 100);

      // MBTI Code
      const mbti = document.getElementById('result-mbti-code').innerText;
      ctx.fillStyle = isDark ? '#f472b6' : '#db2777';
      ctx.font = '900 84px Pretendard, sans-serif';
      ctx.fillText(mbti, 400, 210);

      // Title & Subtitle
      const title = document.getElementById('result-type-title').innerText;
      const sub = document.getElementById('result-type-sub').innerText;

      ctx.fillStyle = isDark ? '#ffffff' : '#0f172a';
      ctx.font = 'bold 34px Pretendard, sans-serif';
      ctx.fillText(title, 400, 290);

      ctx.fillStyle = isDark ? '#c084fc' : '#7c3aed';
      ctx.font = '600 22px Pretendard, sans-serif';
      ctx.fillText(sub, 400, 340);

      // Avatar Icon Box
      ctx.fillStyle = isDark ? '#1e293b' : '#ffffff';
      ctx.fillRect(320, 380, 160, 160);
      const icon = document.getElementById('result-icon-box').innerText;
      ctx.font = '90px Pretendard, sans-serif';
      ctx.fillText(icon, 400, 500);

      // Key Traits Summary
      const mbtiData = FULL_16_MBTI[mbti] || FULL_16_MBTI['ENFP'];
      ctx.fillStyle = isDark ? '#cbd5e1' : '#334155';
      ctx.font = '18px Pretendard, sans-serif';

      let y = 610;
      mbtiData.traits.slice(0, 4).forEach((trait, i) => {
        ctx.fillText(`• ${trait}`, 400, y);
        y += 36;
      });

      // Footer
      ctx.fillStyle = '#64748b';
      ctx.font = '18px Pretendard, sans-serif';
      ctx.fillText('https://mindlab.app • 다차원 성향 탐색', 400, 920);

      // Download
      const link = document.createElement('a');
      link.download = `MIND_LAB_${mbti}_Photocard.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();

      showToast("💾 HD 포토카드가 다운로드되었습니다!");
    }

