<!DOCTYPE html>
<html lang="ko" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>MIND LAB PRO | 300+ 초몰입형 MBTI 성향 스펙트럼</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f3ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              800: '#3730a3',
              900: '#312e81'
            },
            accent: {
              pink: '#ec4899',
              purple: '#a855f7',
              cyan: '#06b6d4',
              amber: '#f59e0b'
            }
          },
          fontFamily: {
            sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'Roboto', 'sans-serif'],
          },
          animation: {
            'float': 'float 4s ease-in-out infinite',
            'pulse-glow': 'pulseGlow 2.5s ease-in-out infinite',
            'spin-slow': 'spin 12s linear infinite',
            'shimmer': 'shimmer 2.5s linear infinite',
            'slot-reel': 'slotReel 0.1s linear infinite'
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-10px)' },
            },
            pulseGlow: {
              '0%, 100%': { opacity: '0.4', filter: 'drop-shadow(0 0 15px rgba(99,102,241,0.4))' },
              '50%': { opacity: '0.9', filter: 'drop-shadow(0 0 30px rgba(236,72,153,0.6))' }
            },
            shimmer: {
              '0%': { backgroundPosition: '-200% 0' },
              '100%': { backgroundPosition: '200% 0' }
            }
          }
        }
      }
    }
  </script>

  <!-- External Icons & Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css">

  <!-- Chart.js for MBTI Spectrum Radar Chart & Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <!-- Custom CSS for Polish and Animations -->
  <style>
    * {
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Pretendard', sans-serif;
      transition: background-color 0.3s ease, color 0.3s ease;
      overflow-x: hidden;
    }

    /* Light Theme */
    html.light body {
      background-color: #f8fafc;
      color: #0f172a;
    }

    /* Dark Theme */
    html.dark body {
      background-color: #030712;
      color: #f3f4f6;
    }

    /* Premium Glassmorphism Cards */
    html.light .glass-card {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 20px 40px -15px rgba(99, 102, 241, 0.08);
    }

    html.dark .glass-card {
      background: rgba(15, 23, 42, 0.78);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
    }

    .glass-card-interactive {
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    html.light .glass-card-interactive:hover {
      transform: translateY(-5px) scale(1.01);
      border-color: rgba(99, 102, 241, 0.4);
      box-shadow: 0 25px 50px -12px rgba(99, 102, 241, 0.18);
    }

    html.dark .glass-card-interactive:hover {
      transform: translateY(-5px) scale(1.01);
      border-color: rgba(168, 85, 247, 0.5);
      box-shadow: 0 25px 50px -12px rgba(168, 85, 247, 0.25);
    }

    /* Gradient Typography */
    .gradient-text {
      background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    html.dark .gradient-text {
      background: linear-gradient(135deg, #818cf8 0%, #c084fc 50%, #f472b6 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    html.light ::-webkit-scrollbar-track { background: #f1f5f9; }
    html.light ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    html.dark ::-webkit-scrollbar-track { background: #030712; }
    html.dark ::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 9999px; }

    /* Page View Transitions */
    .page-screen {
      display: none;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .page-screen.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    /* Quiz Slide Animations */
    .slide-enter-next {
      animation: slideNext 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .slide-enter-prev {
      animation: slidePrev 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes slideNext {
      from { opacity: 0; transform: translateX(40px) scale(0.98); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }
    @keyframes slidePrev {
      from { opacity: 0; transform: translateX(-40px) scale(0.98); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }

    /* Shimmer Effect */
    .shimmer-bg {
      background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.1) 50%, rgba(255,255,255,0) 100%);
      background-size: 200% 100%;
      animation: shimmer 2.5s infinite;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-indigo-500 selection:text-white">

