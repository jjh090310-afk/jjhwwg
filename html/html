    async function generateCustomQuizWithGemini() {
      const inputVal = document.getElementById('ai-prompt-input').value.trim();
      if (!inputVal) {
        showToast("⚠️ 집필하고 싶은 주제를 입력해주세요!");
        return;
      }

      const btn = document.getElementById('ai-generate-btn');
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> <span>Gemini AI가 시나리오 생성 중...</span>`;

      try {
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        const systemPrompt = `You are an expert Korean MBTI quiz author. Generate an immersive 8-question MBTI scenario quiz based on the requested theme in JSON format matching this schema:
        {
          "title": "테스트 제목",
          "icon": "이모지 1개",
          "role": "역할명",
          "setting": "세계관 배경 설명 1문장",
          "questions": [
            { "axis": "E/I", "q": "질문 내용", "A": "선택지 A", "B": "선택지 B" }
          ]
        }
        Provide exactly 2 questions for each axis (E/I, S/N, T/F, J/P). Make choices funny, relatable, and authentic in Korean. Return valid JSON only.`;

        const payload = {
          contents: [{ parts: [{ text: `주제: ${inputVal}` }] }],
          systemInstruction: { parts: [{ text: systemPrompt }] },
          generationConfig: { responseMimeType: "application/json" }
        };

        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        const responseText = data.candidates?.[0]?.content?.parts?.[0]?.text;

        if (responseText) {
          const parsed = JSON.parse(responseText);

          const customTheme = {
            id: Date.now(),
            cat: 'b-side',
            title: parsed.title || `${inputVal} 테스트`,
            icon: parsed.icon || '✨',
            role: parsed.role || inputVal,
            setting: parsed.setting || `${inputVal} 시나리오`,
            customQuestions: parsed.questions,
            participants: 'NEW'
          };

          currentTheme = customTheme;
          currentQuestions = parsed.questions;

          closeCustomAiModal();
          showToast(`✨ AI가 '${parsed.title}' 생성을 완료했습니다!`);
          openIntroPage(customTheme);
        } else {
          throw new Error("Invalid response");
        }

      } catch (err) {
        console.warn("Gemini API fallback triggered:", err);

        const customTheme = {
          id: Date.now(),
          cat: 'b-side',
          title: `'${inputVal}' MBTI 스펙트럼`,
          icon: '💡',
          role: inputVal,
          setting: `${inputVal} 맞춤형 가상 분석 시나리오`,
          participants: 'NEW'
        };

        currentTheme = customTheme;
        currentQuestions = buildStandardQuestions(customTheme);

        closeCustomAiModal();
        showToast(`💡 '${inputVal}' 맞춤 테스트가 준비되었습니다!`);
        openIntroPage(customTheme);

      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }

    function populateMbtiSelects() {
      const keys = Object.keys(FULL_16_MBTI);
      const sel1 = document.getElementById('chem-mbti-1');
      const sel2 = document.getElementById('chem-mbti-2');

      if (!sel1 || !sel2) return;

      sel1.innerHTML = '';
      sel2.innerHTML = '';

      keys.forEach((k) => {
        sel1.add(new Option(`${k} - ${FULL_16_MBTI[k].sub}`, k));
        sel2.add(new Option(`${k} - ${FULL_16_MBTI[k].sub}`, k));
      });

      sel1.value = 'ENFP';
      sel2.value = 'INTJ';
      calculateChemistry();
    }

