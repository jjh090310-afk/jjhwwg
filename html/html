          { axis: 'J/P', q: '100억 자산 운용 포트폴리오 스타일은?', A: '예금 40%, 부동산 40%, 주식 20% 엄격한 비율 준수.', B: '그때그때 재미있는 사업이나 필이 오는데 투자.' },
          { axis: 'J/P', q: '세계 여행을 떠날 때 계획 스타일은?', A: '비행기, 호텔, 일자별 투어 완벽 예약 완료.', B: '퍼스트 클래스 티켓만 끊고 현지 도착해서 결정.' },
          { axis: 'J/P', q: '사고 싶은 차를 정할 때?', A: '유지비와 옵션 가격을 세심하게 비교 후 계약.', B: '매장에 들어가서 제일 예쁜 거 즉석 일시불 결제.' }
        ]
      }
    ];

    // Populate Catalog up to 300 Themes procedurally
    let CATALOG = [...TOPIC_PRESETS];
    const THEME_SEEDS = [
      { name: "이세계 영지 경영 영주", cat: "fantasy", icon: "🏰" },
      { name: "심야 편의점 야간 알바 24시", cat: "office", icon: "🏪" },
      { name: "아이돌 데뷔조 메인 센터", cat: "romance", icon: "🎤" },
      { name: "우주 탐사선 함장 워프 대작전", cat: "scifi", icon: "🛸" },
      { name: "댕댕이 견생 성향 분석", cat: "animal", icon: "🐶" },
      { name: "외계인 침공 지구 대표 협상가", cat: "b-side", icon: "👽" },
      { name: "미슐랭 3스타 비밀 셰프", cat: "office", icon: "🍳" },
      { name: "무인도 조난 생존 모험가", cat: "b-side", icon: "🏝️" },
      { name: "혹한의 북부 대공 소설 주인공", cat: "fantasy", icon: "❄️" },
      { name: "연애 밀당 칼답장 분석기", cat: "romance", icon: "📱" }
    ];

    for (let i = CATALOG.length + 1; i <= 300; i++) {
      const seed = THEME_SEEDS[i % THEME_SEEDS.length];
      CATALOG.push({
        id: i,
        cat: seed.cat,
        title: `${seed.name} (Vol.${Math.ceil(i/10)})`,
        icon: seed.icon,
        role: `${seed.name} 주인공`,
        participants: `${(Math.random() * 28 + 2).toFixed(1)}만명`,
        setting: `${seed.name} 상황에서의 입체적 심리 성향 스펙트럼`
