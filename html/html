  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 w-full flex-1">

    <!-- ================================================================= -->
    <!-- PAGE 1: MAIN CATALOG HUB -->
    <!-- ================================================================= -->
    <section id="hub-page" class="page-screen active">
      
      <!-- HERO BANNER -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-600/10 via-purple-600/10 to-pink-600/10 dark:from-slate-950 dark:via-indigo-950/70 dark:to-slate-950 border border-indigo-200/80 dark:border-slate-800 p-6 sm:p-10 mb-8 shadow-2xl">
        <div class="absolute -right-20 -top-20 w-96 h-96 bg-indigo-500/20 dark:bg-indigo-600/20 rounded-full blur-3xl pointer-events-none animate-pulse-glow"></div>
