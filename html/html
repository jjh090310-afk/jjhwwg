    }

    function closeChemistryModal() {
      document.getElementById('chem-modal').classList.add('opacity-0', 'pointer-events-none');
    }

    function calculateChemistry() {
      const m1 = document.getElementById('chem-mbti-1').value;
      const m2 = document.getElementById('chem-mbti-2').value;

      const d1 = FULL_16_MBTI[m1];
      const d2 = FULL_16_MBTI[m2];

      const scoreBox = document.getElementById('chem-score');
      const statusBox = document.getElementById('chem-status');
      const descBox = document.getElementById('chem-desc');

      if (d1.best.includes(m2)) {
        scoreBox.innerText = "98점";
        statusBox.innerText = "💘 환상의 시너지 짝꿍!";
        descBox.innerText = `${m1}와 ${m2}는 서로의 단점을 기가 막히게 보완하고 지루할 틈이 없는 최고의 케미 조합입니다.`;
      } else if (d1.worst.includes(m2)) {
        scoreBox.innerText = "38점";
        statusBox.innerText = "⚡ 서로 다른 평행선 극반대 조합";
        descBox.innerText = `${m1}와 ${m2}는 관점과 가치관이 상반되어 대화와 배려가 많이 필요한 관계입니다.`;
      } else {
        scoreBox.innerText = "78점";
        statusBox.innerText = "🤝 무난하고 편안한 균형 조합";
        descBox.innerText = `${m1}와 ${m2}는 편안하게 협력할 수 있으며 서로에게 유익한 자극을 주는 케미입니다.`;
      }
    }
